{
  "name": "@mongez/encryption",
  "version": "2.0.2",
  "description": "Authenticated encryption for JSON-encodable values using WebCrypto AES-256-GCM with PBKDF2 key derivation, plus the common hash functions (md5, sha1, sha256, sha512) and a legacy crypto-js decrypt path.",
  "main": "src/index.ts",
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "crypto-js": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "crypto",
    "crypto-js",
    "encryption",
    "decryption",
    "encrypt",
    "decrypt",
    "hash",
    "md5",
    "sha1",
    "sha256",
    "sha512",
    "aes",
    "aes-gcm",
    "aead",
    "pbkdf2",
    "webcrypto",
    "mongez"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hassanzohdy/mongez-encryption"
  },
  "author": "hassanzohdy",
  "license": "MIT"
}
